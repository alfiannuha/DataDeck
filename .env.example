# DataDeck environment configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and replace values locally. NEVER commit real secrets.
#
# Values below are safe development defaults. For a production-like run:
#   - set ENCRYPTION_KEY to your own 32-byte/64-hex value (never the example),
#   - keep HOST at 127.0.0.1 unless you deliberately enable remote access,
#   - point STORAGE_PATH at a user-private directory (e.g. ~/.datadeck/datadeck.db).

# --- Network ---
# HOST defaults to loopback (127.0.0.1). Widening it requires ALLOW_REMOTE=1;
# startup REFUSES a non-loopback HOST without it (no authentication exists).
HOST=127.0.0.1
PORT=8080
# Set to 1 only to deliberately bind beyond loopback (network exposure).
ALLOW_REMOTE=

# --- Internal storage (embedded SQLite app store) ---
# Parent directory is created 0700; the store file is narrowed to 0600.
STORAGE_PATH=./data/datadeck.db

# --- Runtime ---
# development | test | production  (affects validation/logging expectations)
ENVIRONMENT=development
# debug | info | warn | error
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (explicit allowlist).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Credential encryption (AES-256-GCM) ---
# Required at startup. Exactly 32 raw bytes OR 64 hexadecimal characters.
# The value below is an EXAMPLE ONLY — generate your own and never commit a real
# key. There is no insecure fallback: an absent or invalid key aborts startup.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Frontend (exposed to the browser — must not contain secrets) ---
# Development: point at the daemon. Future single-binary/same-origin: set "".
NEXT_PUBLIC_API_URL=http://localhost:8080
